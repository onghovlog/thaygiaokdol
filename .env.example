# ==========================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG BACKEND - THẦY GIÁO KDOL
# Slogan: "1 đơn hàng - 1 nụ cười"
# ==========================================================

# Cổng lắng nghe của Express Server (Mặc định 5000)
PORT=5000

# Môi trường ứng dụng (development | production | test)
NODE_ENV=development

# Chuỗi kết nối MongoDB Atlas (Thay thế <username>, <password>, <dbname>)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/thaygiaokdol?retryWrites=true&w=majority

# Cấu hình CORS Origins được phép gọi API (phân tách bởi dấu phẩy)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5000,http://127.0.0.1:5000

